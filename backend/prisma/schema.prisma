// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum CustomerType {
  RETAILER
  WHOLESALER
  DISTRIBUTOR
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(SALES)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  customers      Customer[]
  challans       Challan[]
  stockMovements StockMovement[]
  followUps      FollowUp[]

  @@map("users")
}

model Customer {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String?
  businessName String?        @map("business_name")
  gstNumber    String?        @map("gst_number")
  customerType CustomerType   @default(RETAILER) @map("customer_type")
  address      String?
  status       CustomerStatus @default(ACTIVE)
  followUpDate DateTime?      @map("follow_up_date")
  notes        String?
  createdById  String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  createdBy User       @relation(fields: [createdById], references: [id])
  challans  Challan[]
  followUps FollowUp[]

  @@map("customers")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  category      String?
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  currentStock  Int      @default(0) @map("current_stock")
  minStockQty   Int      @default(0) @map("min_stock_qty")
  location      String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@map("products")
}

model StockMovement {
  id           String       @id @default(uuid())
  productId    String       @map("product_id")
  quantity     Int
  movementType MovementType @map("movement_type")
  reason       String?
  referenceId  String?      @map("reference_id") // challan id or manual ref
  createdById  String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  product     Product @relation(fields: [productId], references: [id])
  createdBy   User    @relation(fields: [createdById], references: [id])

  @@map("stock_movements")
}

model Challan {
  id               String        @id @default(uuid())
  challanNumber    String        @unique @map("challan_number")
  customerId       String        @map("customer_id")
  customerSnapshot Json          @map("customer_snapshot") // snapshot of customer at time of challan
  totalQuantity    Int           @default(0) @map("total_quantity")
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status           ChallanStatus @default(DRAFT)
  notes            String?
  createdById      String        @map("created_by")
  confirmedAt      DateTime?     @map("confirmed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  customer     Customer      @relation(fields: [customerId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  items        ChallanItem[]

  @@map("challans")
}

model ChallanItem {
  id              String  @id @default(uuid())
  challanId       String  @map("challan_id")
  productId       String  @map("product_id")
  productSnapshot Json    @map("product_snapshot") // snapshot of product at time of challan
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  // Relations
  challan Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("challan_items")
}

model FollowUp {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  note        String
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("follow_ups")
}
