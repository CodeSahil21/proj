# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Environment files (never commit secrets) ─────────────────────────────────
.env
.env.local
.env.*.local
# Keep examples
!.env.example

# ─── Prisma ───────────────────────────────────────────────────────────────────
backend/prisma/migrations/
# Keep schema and seed
!backend/prisma/schema.prisma
!backend/prisma/seed.ts

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose and Dockerfiles tracked
# Ignore local override
docker-compose.override.yml

# ─── Coverage / test artifacts ────────────────────────────────────────────────
coverage/
.nyc_output/
